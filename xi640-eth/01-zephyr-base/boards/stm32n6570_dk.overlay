/*
 * Device tree overlay for Xi 640 ETH thermal camera
 * Simplified HyperRAM frame buffer allocation on STM32N6570-DK
 *
 * No 'chosen' section needed - Zephyr uses default SRAM from board DTS
 */

/ {
	soc {
		/* HyperRAM - 8 MB external PSRAM via XSPI @ 0x90000000 */
		hyperram: memory@90000000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x90000000 DT_SIZE_M(8)>;
			zephyr,memory-region = "HYPERRAM";
		};
	};
};

/* Enable HyperRAM region */
&hyperram {
	status = "okay";
};
